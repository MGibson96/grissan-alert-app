# Gmail IMAP (inbox being monitored for OEM alert emails)
GMAIL_ADDRESS=alerts@example.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Gmail SMTP (used to send the rebranded customer email; same account as above works)
SMTP_ADDRESS=${GMAIL_ADDRESS}
SMTP_APP_PASSWORD=${GMAIL_APP_PASSWORD}

# OEM sender address to watch for (only mail from this address is picked up)
OEM_SENDER_FILTER=noreply@oem-vendor.example.com

# How often to poll the inbox, in seconds
POLL_INTERVAL_SECONDS=300

# Branding
COMPANY_NAME=Ailsa

# Internal notification address — where parse/match failures get reported
INTERNAL_ALERT_EMAIL=ops@example.com

# AWS SNS (SMS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# SQLite audit log path
AUDIT_DB_PATH=./data/audit.db

# Recipient mapping config
RECIPIENTS_CONFIG_PATH=./config/recipients.yaml
